# Heroku API Configuration (Single Account Mode)
HEROKU_API_KEY=your_heroku_api_key_here
HEROKU_ACCOUNT_EMAIL=your_heroku_email@example.com
# Optional: pin a specific enterprise account id or name slug
# ENTERPRISE_ACCOUNT_ID_OR_NAME=your-enterprise-account-id-or-name

# Multi-Group Configuration (Optional - for monitoring multiple accounts/teams)
# Leave empty to use single account mode above
# Set to JSON array for multi-group mode - see MULTI_GROUP_SETUP.md for details
# HEROKU_GROUPS=[{"id":"personal","name":"Personal Apps","type":"personal","apiKey":"token","accountEmail":"you@example.com","teamName":null}]

# Notification Configuration
NOTIFICATION_EMAIL=alerts@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Usage Thresholds (percentages)
DYNO_THRESHOLD=80
CONNECT_THRESHOLD=80
ADDON_THRESHOLD=80

# App Configuration
PORT=3001
NODE_ENV=production
